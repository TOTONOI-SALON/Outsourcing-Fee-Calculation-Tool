      html += '<tr><td>'+escapeHtml(p.label)+'</td>'+
        '<td class="field num"><input class="price" type="number" data-id="'+p.id+'" data-field="price" value="'+a.price+'">'+
          (a.price!==a.autoPrice ? '<span class="auto-hint">自動:'+yen(a.autoPrice)+' <button class="reset-btn" data-reset="'+p.id+'">戻す</button></span>' : '<span class="auto-hint">該当明細の合算</span>')+
        '</td>'+
        '<td class="field num">1</td>'+
        '<td class="field num">'+Math.round(a.rate*100)+'%</td>'+
        '<td class="field num">'+yen(a.amount)+'</td></tr>';
    }else{
      html += '<tr><td>'+escapeHtml(p.label)+'</td><td class="field num">—</td><td class="field num">—</td><td class="field num">—</td>'+
        '<td class="field num"><input class="amt-manual" type="number" data-id="'+p.id+'" data-field="amount" value="'+a.amount+'">'+
        (a.autoAmount ? '<span class="auto-hint">自動:'+yen(a.autoAmount)+'（指名'+a.nomCount+'件）</span>' : '')+
        '</td></tr>';
    }
  });
  const total = Object.values(amounts).reduce((s,a)=>s+(a.amount||0),0);
  html += '</tbody><tfoot><tr><td colspan="4">支給総額</td><td class="num">'+yen(total)+'</td></tr></tfoot></table>';
  wrap.innerHTML = html;

  wrap.querySelectorAll('input[data-id]').forEach(inp=>{
    inp.addEventListener('change',(e)=>{
      const id = e.target.dataset.id, field = e.target.dataset.field;
      const val = e.target.value==='' ? null : Number(e.target.value);
      if(field==='qty') S.manualQty[id]=val;
      else if(field==='price') S.manualRevenue[id]=val;
      else if(field==='amount') S.manualAmount[id]=val;
      renderCatTable(); renderDeductWrap(); renderHero(); renderSheets();
    });
  });
  wrap.querySelectorAll('[data-reset]').forEach(btn=>{
    btn.addEventListener('click',(e)=>{
      const id = e.target.dataset.reset;
      delete S.manualQty[id]; delete S.manualRevenue[id];
      renderCatTable(); renderDeductWrap(); renderHero(); renderSheets();
    });
  });
}

/* ============================== 控除・支給総額・差引 ============================== */
function totals(){
  const st = currentStaff();
  const amounts = calcAmounts();
  const gross = Object.values(amounts).reduce((s,a)=>s+(a.amount||0),0);
  const ded = {};
  let dedTotal = 0;
  st.deductions.forEach(d=>{
    const auto = d.kind==='percent' ? Math.round(gross*(d.percent||0)/100) : (d.amount||0);
    const shown = (S.manualDeductions[d.id]!=null) ? S.manualDeductions[d.id] : auto;
    ded[d.id] = {auto, shown};
    dedTotal += Number(shown)||0;
  });
  return {amounts, gross, ded, dedTotal, net: gross-dedTotal};
}

function renderDeductWrap(){
  const wrap = document.getElementById('deductWrap');
  const st = currentStaff();
  const t = totals();
  wrap.innerHTML = '<div class="deduct-grid">'+st.deductions.map(d=>{
    const info = t.ded[d.id];
    const isAuto = S.manualDeductions[d.id]==null;
    const labelExtra = d.kind==='percent' ? '（支給総額の'+d.percent+'%）' : '';
    return '<div class="deduct-item"><label>'+escapeHtml(d.label)+labelExtra+'</label>'+
      '<input type="number" data-ded="'+d.id+'" value="'+info.shown+'">'+
      (!isAuto ? '<span class="auto-hint">自動:'+yen(info.auto)+' <button class="reset-btn" data-dedreset="'+d.id+'">戻す</button></span>' : (d.kind==='percent' ? '<span class="auto-hint">自動計算</span>' : ''))+
      '</div>';
  }).join('')+'</div>';
  wrap.querySelectorAll('input[data-ded]').forEach(inp=>{
    inp.addEventListener('change',(e)=>{
      S.manualDeductions[e.target.dataset.ded] = e.target.value==='' ? null : Number(e.target.value);
      renderDeductWrap(); renderHero(); renderSheets();
    });
  });
  wrap.querySelectorAll('[data-dedreset]').forEach(btn=>{
    btn.addEventListener('click',(e)=>{
      delete S.manualDeductions[e.target.dataset.dedreset];
      renderDeductWrap(); renderHero(); renderSheets();
    });
  });
}

/* ============================== 控除項目編集パネル ============================== */
function renderDeductionsBox(){
  const box = document.getElementById('deductionsBox');
  const st = currentStaff();
  let html = '<div class="hint">名前・種類（固定額／支給総額の％）・初期値を編集できます。並び順は明細書の表示順になります。</div>';
  st.deductions.forEach((d,i)=>{
    html += '<div class="product-card" data-i="'+i+'">'+
      '<div class="pc-row1">'+
        '<input class="pc-label" data-f="label" value="'+escapeHtml(d.label)+'">'+
        '<select class="pc-kind" data-f="kind">'+
          '<option value="fixed"'+(d.kind==='fixed'?' selected':'')+'>固定額</option>'+
          '<option value="percent"'+(d.kind==='percent'?' selected':'')+'>支給総額の％</option>'+
        '</select>'+
        '<button data-up="1" title="上へ">↑</button><button data-down="1" title="下へ">↓</button>'+
        '<button class="pc-del" data-del="1" title="削除">✕</button>'+
      '</div>'+
      '<div class="pc-row2">'+
        (d.kind==='fixed'
          ? '<div class="pc-field"><label>金額（初期値）</label><input type="number" data-f="amount" value="'+(d.amount||0)+'"></div>'
          : '<div class="pc-field"><label>％</label><input type="number" data-f="percent" value="'+(d.percent||0)+'"></div>')+
      '</div>'+
    '</div>';
  });
  html += '<button class="btn ghost small" id="btnAddDeduction">＋ 控除項目を追加</button>';
  box.innerHTML = html;

  async function persist(){ await sSet('staff-'+st.id, st); renderDeductWrap(); renderHero(); renderSheets(); }

  box.querySelectorAll('.product-card').forEach(card=>{
    const i = parseInt(card.dataset.i,10);
    card.querySelectorAll('input,select').forEach(el=>{
      el.addEventListener('change', async (e)=>{
        const f = e.target.dataset.f;
        const d = st.deductions[i];
        if(f==='label') d.label = e.target.value;
        else if(f==='kind') d.kind = e.target.value;
        else if(f==='amount') d.amount = Number(e.target.value)||0;
        else if(f==='percent') d.percent = Number(e.target.value)||0;
        await persist();
        if(f==='kind') renderDeductionsBox();
      });
    });
    card.querySelector('[data-del]').addEventListener('click', async ()=>{
      if(!confirm('「'+st.deductions[i].label+'」を削除しますか？')) return;
      st.deductions.splice(i,1);
      await persist();
      renderDeductionsBox();
    });
    card.querySelector('[data-up]').addEventListener('click', async ()=>{
      if(i===0) return;
      [st.deductions[i-1],st.deductions[i]] = [st.deductions[i],st.deductions[i-1]];
      await persist();
      renderDeductionsBox();
    });
    card.querySelector('[data-down]').addEventListener('click', async ()=>{
      if(i===st.deductions.length-1) return;
      [st.deductions[i+1],st.deductions[i]] = [st.deductions[i],st.deductions[i+1]];
      await persist();
      renderDeductionsBox();
    });
  });
  document.getElementById('btnAddDeduction').addEventListener('click', async ()=>{
    st.deductions.push(mkDeduction('新しい項目','fixed',0));
    await persist();
    renderDeductionsBox();
  });
}

function renderHero(){
  const wrap = document.getElementById('heroWrap');
  const st = currentStaff();
  if(!st){ wrap.innerHTML=''; return; }
  const t = totals();
  wrap.innerHTML =
    '<div class="hero"><div>'+
    '<div class="label">'+escapeHtml(st.name)+' 様　'+escapeHtml(S.currentMonth)+' 分　差引支給額</div>'+
    '<div class="amount">'+yen(t.net)+'</div>'+
    '<div class="sub">支給総額 '+yen(t.gross)+'　－　控除総額 '+yen(t.dedTotal)+'</div>'+
    '</div></div>';
}

/* ============================== 明細書プレビュー ============================== */
function statementTable(st, amounts){
  let rows = '';
  st.products.forEach(p=>{
    const a = amounts[p.id];
    if(a.kind==='manual'){
      rows += '<tr><td>'+escapeHtml(p.label)+'</td><td class="num">—</td><td class="num">—</td><td class="num">—</td><td class="num">'+yen(a.amount)+'</td></tr>';
    }else{
      rows += '<tr><td>'+escapeHtml(p.label)+'</td><td class="num">'+yen(a.price)+'</td><td class="num">'+a.qty+'</td><td class="num">'+Math.round(a.rate*100)+'%</td><td class="num">'+yen(a.amount)+'</td></tr>';
    }
  });
  return '<table><thead><tr><th>商品</th><th class="num">単価</th><th class="num">数量</th><th class="num">%</th><th class="num">金額</th></tr></thead><tbody>'+rows+'</tbody></table>';
}
function deductRowsHtml(st, t){
  return '<table><tbody>'+
    st.deductions.map(d=>'<tr><td>'+escapeHtml(d.label)+'</td><td class="num">'+yen(t.ded[d.id].shown)+'</td></tr>').join('')+
    '</tbody><tfoot><tr><td>控除総額</td><td class="num">'+yen(t.dedTotal)+'</td></tr></tfoot></table>';
}
function renderSheets(){
  const wrap = document.getElementById('sheetWrap');
  const st = currentStaff();
  if(!st){ wrap.innerHTML=''; return; }
  const t = totals();
  const [y,m] = (S.currentMonth||'').split('-');
  const jpTitle = (y&&m) ? (y+'年'+parseInt(m,10)+'月分') : '';

  const paymentSheet =
    '<div class="sheet payment-sheet">'+
    '<h3>'+jpTitle+'　支払明細書</h3>'+
    '<div class="addr-block"><span class="to">'+escapeHtml(st.name)+' 殿</span>'+
      '<div class="from">'+
        '<div class="from-seal-row">'+
          '<span>'+escapeHtml(S.companyInfo.name)+'</span>'+
          (S.companyInfo.seal ? '<img class="seal-img" src="'+S.companyInfo.seal+'" alt="社印">' : '')+
        '</div>'+
        '〒'+escapeHtml(S.companyInfo.zip)+'<br>'+escapeHtml(S.companyInfo.address)+
      '</div></div>'+
    '<div class="total-box"><div class="k">差引支給額</div><div class="v">'+yen(t.net)+'</div></div>'+
    '<div class="sec-title">支給</div>'+
    statementTable(st, t.amounts)+
    '<div class="sec-title" style="margin-top:10px;">控除</div>'+
    deductRowsHtml(st, t)+
    '</div>';

  const invoiceSheet =
    '<div class="sheet invoice-sheet">'+
    '<h3>'+jpTitle+'　請求書</h3>'+
    '<div class="addr-block"><span class="to">'+escapeHtml(S.companyInfo.name)+' 様</span>'+
      '<div class="from">請求外注者：'+escapeHtml(st.name)+'<br>'+escapeHtml(st.zip?('〒'+st.zip+' '):'')+escapeHtml(st.address)+'</div></div>'+
    '<div class="total-box"><div class="k">差引支給額</div><div class="v">'+yen(t.net)+'</div></div>'+
    '<div class="sec-title">支給</div>'+
    statementTable(st, t.amounts)+
    '<div class="sec-title" style="margin-top:10px;">控除</div>'+
    deductRowsHtml(st, t)+
    '</div>';

  wrap.innerHTML = paymentSheet + invoiceSheet;
}

/* ============================== 保存 / 読込 ============================== */
function recordKey(){ return 'record-'+S.currentStaffId+'-'+S.currentMonth; }
async function saveRecord(){
  const rec = {
    csvRows:S.csvRows, manualQty:S.manualQty, manualRevenue:S.manualRevenue, manualAmount:S.manualAmount,
    manualDeductions:S.manualDeductions, savedAt:new Date().toISOString()
  };
  await sSet(recordKey(), rec);
  await refreshSavedHint();
  const hint = document.getElementById('savedHint');
  hint.textContent = '保存しました（'+new Date().toLocaleString('ja-JP')+'）';
}
async function loadRecord(){
  const rec = await sGet(recordKey());
  if(!rec){ alert('この月・このスタッフの保存データが見つかりません。'); return; }
  S.csvRows = rec.csvRows||[];
  S.manualQty = rec.manualQty||{};
  S.manualRevenue = rec.manualRevenue||{};
  S.manualAmount = rec.manualAmount||{};
  S.manualDeductions = rec.manualDeductions||{};
  renderAll();
}
async function refreshSavedHint(){
  const rec = await sGet(recordKey());
  const hint = document.getElementById('savedHint');
  hint.textContent = rec ? ('保存データあり（'+new Date(rec.savedAt).toLocaleString('ja-JP')+'）') : 'この月の保存データはまだありません。';
  hint.classList.toggle('active', !!rec);
}

/* ============================== モーダル: 会社情報 ============================== */
function openCompanyModal(){
  const root = document.getElementById('modalRoot');
  let sealDraft = S.companyInfo.seal || '';
  root.innerHTML =
    '<div class="modal-backdrop" id="backdrop"><div class="modal">'+
    '<h3>会社情報</h3>'+
    '<div class="field-row"><label>会社名</label><input id="cName" value="'+escapeHtml(S.companyInfo.name)+'"></div>'+
    '<div class="field-row"><label>郵便番号</label><input id="cZip" value="'+escapeHtml(S.companyInfo.zip)+'"></div>'+
    '<div class="field-row"><label>住所</label><input id="cAddr" value="'+escapeHtml(S.companyInfo.address)+'"></div>'+
    '<div class="field-row"><label>社印（支払明細書に印字されます）</label>'+
      '<div id="cSealPreview" style="margin-bottom:6px;">'+(sealDraft ? '<img src="'+sealDraft+'" style="width:56px;height:56px;object-fit:contain;">' : '<span class="hint">未設定</span>')+'</div>'+
      '<input type="file" id="cSealFile" accept="image/*">'+
      (sealDraft ? '<button type="button" class="btn ghost small" id="cSealRemove" style="margin-top:6px;">社印を削除</button>' : '')+
    '</div>'+
    '<div class="modal-actions"><button class="btn ghost" id="cCancel">キャンセル</button><button class="btn" id="cSave">保存</button></div>'+
    '</div></div>';
  document.getElementById('backdrop').addEventListener('click',(e)=>{ if(e.target.id==='backdrop') root.innerHTML=''; });
  document.getElementById('cCancel').addEventListener('click', ()=>root.innerHTML='');
  document.getElementById('cSealFile').addEventListener('change', (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = ()=>{
      sealDraft = reader.result;
      document.getElementById('cSealPreview').innerHTML = '<img src="'+sealDraft+'" style="width:56px;height:56px;object-fit:contain;">';
    };
    reader.readAsDataURL(file);
  });
  const removeBtn = document.getElementById('cSealRemove');
  if(removeBtn) removeBtn.addEventListener('click', ()=>{
    sealDraft = '';
    document.getElementById('cSealPreview').innerHTML = '<span class="hint">未設定</span>';
  });
  document.getElementById('cSave').addEventListener('click', async ()=>{
    S.companyInfo = {
      name: document.getElementById('cName').value,
      zip: document.getElementById('cZip').value,
      address: document.getElementById('cAddr').value,
      seal: sealDraft
    };
    await sSet('company-info', S.companyInfo);
    root.innerHTML='';
    renderSheets();
  });
}

/* ============================== モーダル: スタッフ追加/編集 ============================== */
function openStaffModal(staff){
  const isNew = !staff;
  const s = staff ? {...staff} : {
    id:uid(), name:'', aliases:[], address:'', zip:'',
    products: defaultProducts(DEFAULT_PRICES, DEFAULT_RATE_STANDARD, DEFAULT_RATE_HEAD, 0),
    deductions: defaultDeductions()
  };
  const root = document.getElementById('modalRoot');
  root.innerHTML =
    '<div class="modal-backdrop" id="backdrop"><div class="modal">'+
    '<h3>'+(isNew?'スタッフを追加':'基本情報を編集')+'</h3>'+
    '<div class="field-row"><label>氏名</label><input id="sName" value="'+escapeHtml(s.name)+'"></div>'+
    '<div class="field-row"><label>CSV上の表記（カンマ区切りで複数可・表記ゆれ対応）</label><input id="sAliases" value="'+escapeHtml((s.aliases||[]).join(', '))+'" placeholder="例: 浅野  恵理, アサノ  エリ"></div>'+
    '<div class="field-row"><label>郵便番号（請求書用）</label><input id="sZip" value="'+escapeHtml(s.zip)+'"></div>'+
    '<div class="field-row"><label>住所（請求書用）</label><input id="sAddr" value="'+escapeHtml(s.address)+'"></div>'+
    '<div class="hint">商品（メニュー区分）や単価・歩合率、控除項目は、画面の「02 分類の確認・修正」内の「商品を編集する」「控除項目を編集する」から設定できます。</div>'+
    '<div class="modal-actions">'+
      (isNew?'':'<button class="btn warn" id="sDelete" style="margin-right:auto;">削除</button>')+
      '<button class="btn ghost" id="sCancel">キャンセル</button><button class="btn" id="sSave">保存</button>'+
    '</div>'+
    '</div></div>';

  document.getElementById('backdrop').addEventListener('click',(e)=>{ if(e.target.id==='backdrop') root.innerHTML=''; });
  document.getElementById('sCancel').addEventListener('click', ()=>root.innerHTML='');
  if(!isNew){
    document.getElementById('sDelete').addEventListener('click', async ()=>{
      if(!confirm(s.name+' を削除しますか？（保存済みの月次データは残ります）')) return;
      S.staffList = S.staffList.filter(x=>x.id!==s.id);
      await sSet('staff-ids', S.staffList.map(x=>x.id));
      if(S.currentStaffId===s.id) S.currentStaffId = S.staffList[0] ? S.staffList[0].id : null;
      root.innerHTML='';
      renderStaffSelect(); resetWorkingData(); renderAll();
    });
  }
  document.getElementById('sSave').addEventListener('click', async ()=>{
    s.name = document.getElementById('sName').value.trim();
    s.aliases = document.getElementById('sAliases').value.split(',').map(x=>x.trim()).filter(Boolean);
    if(s.aliases.length===0 && s.name) s.aliases=[s.name];
    s.zip = document.getElementById('sZip').value;
    s.address = document.getElementById('sAddr').value;
    if(!s.name){ alert('氏名を入力してください。'); return; }

    if(isNew){
      S.staffList.push(s);
      await sSet('staff-ids', S.staffList.map(x=>x.id));
      S.currentStaffId = s.id;
    }else{
      const i = S.staffList.findIndex(x=>x.id===s.id);
      S.staffList[i] = s;
    }
    await sSet('staff-'+s.id, s);
    root.innerHTML='';
    renderStaffSelect(); resetWorkingData(); renderAll();
  });
}

init();
</script>
