/* ============================== CSV 取込 ============================== */
async function handleCsvFile(e, encoding){
  const file = e.target.files[0];
  if(!file) return;
  const buf = await file.arrayBuffer();
  let text;
  try{ text = new TextDecoder(encoding).decode(buf); }
  catch(err){ text = new TextDecoder('utf-8').decode(buf); }

  const table = parseCSVText(text);
  if(table.length<2){ alert('CSVを読み取れませんでした。'); return; }
  const header = table[0].map(h=>h.trim());
  const idx = (name)=>header.indexOf(name);
  const iDate=idx('会計日'), iKubun=idx('会計区分'), iCsvCat=idx('カテゴリ'), iMenu=idx('メニュー・店販・割引・サービス・オプション'),
        iQty=idx('個数'), iAmount=idx('金額'), iStaff=idx('スタッフ'), iNom=idx('指名'), iNewRep=idx('新規再来');

  const st = currentStaff();
  const aliases = (st.aliases && st.aliases.length ? st.aliases : [st.name]).map(normName);

  const rows=[];
  for(let i=1;i<table.length;i++){
    const r = table[i];
    if(!r || r.length<3) continue;
    const staffName = iStaff>=0 ? (r[iStaff]||'') : '';
    if(!aliases.includes(normName(staffName))) continue;
    const kubun = iKubun>=0 ? (r[iKubun]||'') : '';
    if(kubun.includes('取消') || kubun.includes('キャンセル')) continue;
    const menu = iMenu>=0 ? (r[iMenu]||'') : '';
    const csvCat = iCsvCat>=0 ? (r[iCsvCat]||'') : '';
    const qty = iQty>=0 ? (parseInt(r[iQty],10)||0) : 0;
    const amount = iAmount>=0 ? (parseInt(r[iAmount],10)||0) : 0;
    rows.push({
      date: iDate>=0 ? r[iDate] : '',
      menu, csvCat, qty, amount,
      nomination: iNom>=0 ? (r[iNom]||'') : '',
      newOrRepeat: iNewRep>=0 ? (r[iNewRep]||'') : '',
      assignedProductIds: [classifyRow(menu, csvCat, st.products)].filter(Boolean),
      excluded:false,
      manualOverride:false
    });
  }
  if(rows.length===0){
    alert('選択中のスタッフ「'+st.name+'」に一致する行が見つかりませんでした。文字化けしている場合は「UTF-8で再読込」をお試しください。表記ゆれ（カナ表記など）は基本情報の編集から登録できます。');
  }
  S.csvRows = rows;
  S.manualQty={}; S.manualRevenue={}; S.manualAmount={};
  renderAll();
}

function computeAuto(){
  const st = currentStaff();
  const counts={}, revenue={};
  let total=0,newCount=0,repeatCount=0,nomCount=0;
  for(const r of S.csvRows){
    if(r.excluded) continue;
    total++;
    if(r.newOrRepeat && r.newOrRepeat.includes('新規')) newCount++;
    else if(r.newOrRepeat) repeatCount++;
    if(r.nomination && r.nomination.includes('指名あり')) nomCount++;
    (r.assignedProductIds||[]).forEach(pid=>{
      const p = st.products.find(x=>x.id===pid);
      if(!p) return;
      if(p.kind==='count') counts[p.id]=(counts[p.id]||0)+r.qty;
      else if(p.kind==='aggregate') revenue[p.id]=(revenue[p.id]||0)+r.amount;
    });
  }
  return {counts,revenue,total,newCount,repeatCount,nomCount};
}

