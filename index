/* ============================== 区分ごとの集計テーブル ============================== */
function calcAmounts(){
  const st = currentStaff();
  const auto = computeAuto();
  const result = {};
  st.products.forEach(p=>{
    if(p.kind==='count'){
      const autoQty = auto.counts[p.id]||0;
      const qty = (S.manualQty[p.id]!=null) ? S.manualQty[p.id] : autoQty;
      result[p.id] = {kind:'count', qty, autoQty, price:p.price, rate:p.rate, amount: Math.round(p.price*qty*p.rate)};
    }else if(p.kind==='aggregate'){
      const autoPrice = auto.revenue[p.id]||0;
      const price = (S.manualRevenue[p.id]!=null) ? S.manualRevenue[p.id] : autoPrice;
      result[p.id] = {kind:'aggregate', qty:1, price, autoPrice, rate:p.rate, amount: Math.round(price*p.rate)};
    }else{
      const autoAmount = p.autoSource==='nomination' ? Math.round((p.price||0)*auto.nomCount) : 0;
      const amount = (S.manualAmount[p.id]!=null) ? S.manualAmount[p.id] : autoAmount;
      result[p.id] = {kind:'manual', amount, autoAmount, nomCount:auto.nomCount};
    }
  });
  return result;
}

