<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>業務委託費 計算ツール</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F3F5F0;
    --panel:#FFFFFF;
    --ink:#20281F ;
    --ink-soft:#5E6B5C;
    --ink-faint:#8B9689;
    --line:#DCE3D9;
    --line-soft:#EAEFE6;
    --accent:#3F6F5E;
    --accent-dark:#2C5245;
    --accent-tint:#E4EEE8;
    --warn:#BE6A46;
    --warn-tint:#FBECE3;
    --radius:10px;
    --serif:'Noto Serif JP', serif;
    --sans:'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    font-size:14px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  button{font-family:inherit;cursor:pointer;}
  input,select,textarea{font-family:inherit;font-size:13px;}
  #app{min-height:100vh;}

  .topbar{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 24px;border-bottom:1px solid var(--line);
    background:var(--panel);
  }
  .brand{display:flex;align-items:baseline;gap:10px;}
  .brand .mark{font-family:var(--serif);font-weight:700;font-size:19px;letter-spacing:.02em;}
  .brand .sub{font-size:11.5px;color:var(--ink-faint);letter-spacing:.06em;}
  .topbar-actions button{
    background:none;border:1px solid var(--line);border-radius:8px;
    padding:7px 13px;font-size:12.5px;color:var(--ink-soft);
  }
  .topbar-actions button:hover{border-color:var(--accent);color:var(--accent-dark);}

  .layout{display:flex;align-items:flex-start;max-width:1240px;margin:0 auto;}
  .sidebar{
    width:250px;flex:0 0 250px;padding:22px 18px;position:sticky;top:0;
    display:flex;flex-direction:column;gap:22px;
  }
  .sidebar-section h3{
    margin:0 0 8px;font-size:11px;letter-spacing:.08em;color:var(--ink-faint);
    text-transform:uppercase;font-weight:700;
  }
  .sidebar-section select, .sidebar-section input[type=month]{
    width:100%;padding:8px 9px;border:1px solid var(--line);border-radius:8px;
    background:var(--panel);color:var(--ink);
  }
  .side-btn{
    width:100%;text-align:left;background:var(--panel);border:1px solid var(--line);
    border-radius:8px;padding:8px 10px;font-size:12.5px;color:var(--ink-soft);margin-top:6px;
  }
  .side-btn:hover{border-color:var(--accent);color:var(--accent-dark);}
  .side-btn.primary{background:var(--accent);color:#fff;border-color:var(--accent);}
  .side-btn.primary:hover{background:var(--accent-dark);}
  .hint{font-size:11.5px;color:var(--ink-faint);margin-top:6px;line-height:1.5;}
  .hint.active{color:var(--warn);}

  .content{flex:1;min-width:0;padding:22px 24px 80px;}

  .step{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px 24px;margin-bottom:20px;}
  .step-head{display:flex;align-items:baseline;gap:12px;margin-bottom:16px;}
  .step-no{font-family:var(--serif);font-size:13px;color:var(--accent);border:1px solid var(--accent-tint);
    background:var(--accent-tint);padding:2px 9px;border-radius:20px;font-weight:700;letter-spacing:.05em;}
  .step-head h2{font-family:var(--serif);font-size:17px;margin:0;font-weight:700;}
  .step-desc{font-size:12.5px;color:var(--ink-soft);margin:-8px 0 16px;}

  .row-flex{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
  .btn{
    background:var(--accent);color:#fff;border:none;border-radius:8px;
    padding:9px 16px;font-size:13px;font-weight:500;
  }
  .btn:hover{background:var(--accent-dark);}
  .btn.ghost{background:none;border:1px solid var(--line);color:var(--ink-soft);}
  .btn.ghost:hover{border-color:var(--accent);color:var(--accent-dark);}
  .btn.small{padding:5px 10px;font-size:12px;}
  .btn.warn{background:var(--warn);}
  .btn.warn:hover{background:#a4573a;}
  .btn[disabled]{opacity:.45;cursor:not-allowed;}

  .stat-cards{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
  .stat-card{background:var(--bg);border:1px solid var(--line-soft);border-radius:10px;padding:10px 16px;min-width:88px;}
  .stat-card .n{font-family:var(--serif);font-size:20px;font-weight:700;}
  .stat-card .l{font-size:11px;color:var(--ink-faint);}

  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  th{
    text-align:left;font-size:11px;color:var(--ink-faint);font-weight:700;
    letter-spacing:.03em;padding:7px 8px;border-bottom:1px solid var(--line);
    position:sticky;top:0;background:var(--panel);
  }
  td{padding:6px 8px;border-bottom:1px solid var(--line-soft);vertical-align:middle;}
  tr:hover td{background:var(--bg);}
  .rows-scroll{max-height:340px;overflow:auto;border:1px solid var(--line-soft);border-radius:10px;margin-top:10px;}
  .menu-name{max-width:320px;white-space:normal;line-height:1.4;}
  .num{text-align:right;font-variant-numeric:tabular-nums;}
  select.cat-select{width:100%;padding:4px 6px;border:1px solid var(--line);border-radius:6px;background:#fff;}
  .row-classify{min-width:210px;}
  .chip-list{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px;}
  .chip{display:inline-flex;align-items:center;gap:4px;background:var(--accent-tint);color:var(--accent-dark);border-radius:20px;padding:2px 4px 2px 9px;font-size:11px;}
  .chip button{border:none;background:none;color:var(--accent-dark);font-size:12px;cursor:pointer;padding:0 4px;line-height:1;}
  .cat-add{width:100%;padding:4px 6px;border:1px solid var(--line);border-radius:6px;background:#fff;font-size:11.5px;}
  .excl-check{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--ink-faint);margin-top:4px;}
  tr.row-excluded td{opacity:.45;}
  .tag{display:inline-block;font-size:10.5px;padding:1px 7px;border-radius:20px;background:var(--accent-tint);color:var(--accent-dark);}
  .tag.repeat{background:#EFEAE0;color:#7A6A46;}
  .tag.nom{background:#F1E4EC;color:#8A4A6C;}

  .panel-box{border:1px dashed var(--line);border-radius:10px;padding:14px 16px;margin-top:6px;background:var(--bg);}

  .product-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px;}
  .pc-row1{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
  .pc-row1 input.pc-label{flex:1;padding:6px 8px;border:1px solid var(--line);border-radius:6px;font-weight:500;}
  .pc-row1 select.pc-kind{padding:6px 8px;border:1px solid var(--line);border-radius:6px;width:130px;}
  .pc-row1 button{border:none;background:none;color:var(--ink-faint);font-size:14px;padding:2px 6px;}
  .pc-row1 button:hover{color:var(--accent-dark);}
  .pc-row1 button.pc-del:hover{color:var(--warn);}
  .pc-row2{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:6px;}
  .pc-field{display:flex;flex-direction:column;gap:2px;}
  .pc-field label{font-size:10px;color:var(--ink-faint);}
  .pc-field input[type=number]{width:78px;padding:5px 7px;border:1px solid var(--line);border-radius:6px;text-align:right;}
  .pc-check{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--ink-soft);}
  .pc-row3{display:flex;gap:8px;}
  .pc-row3 input{flex:1;padding:6px 8px;border:1px solid var(--line);border-radius:6px;font-size:12px;}
  .pc-row3 input.pc-csvcat{flex:0 0 150px;}

  .cat-table td.field{padding:4px 8px;}
  .cat-table input.qty, .cat-table input.price{
    width:84px;padding:5px 7px;border:1px solid var(--line);border-radius:6px;text-align:right;
  }
  .cat-table input.amt-manual{width:100px;padding:5px 7px;border:1px solid var(--line);border-radius:6px;text-align:right;}
  .auto-hint{font-size:10.5px;color:var(--ink-faint);display:block;margin-top:2px;}
  .diff-hint{font-size:10.5px;color:var(--warn);display:block;margin-top:2px;}
  .reset-btn{border:none;background:none;color:var(--accent);font-size:11px;cursor:pointer;padding:0 0 0 4px;}
  .cat-table tfoot td{border-top:2px solid var(--ink);font-weight:700;padding-top:10px;}

  .compare-toggle{font-size:12px;color:var(--accent-dark);text-decoration:underline;cursor:pointer;background:none;border:none;padding:0;margin-top:10px;}

  .deduct-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-top:12px;}
  .deduct-item label{font-size:11.5px;color:var(--ink-soft);display:block;margin-bottom:4px;}
  .deduct-item input{width:100%;padding:7px 9px;border:1px solid var(--line);border-radius:8px;text-align:right;}

  .hero{
    display:flex;align-items:center;justify-content:space-between;
    background:linear-gradient(135deg,var(--accent-dark),var(--accent));
    color:#fff;border-radius:12px;padding:20px 26px;margin-top:4px;
  }
  .hero .label{font-size:12px;letter-spacing:.06em;opacity:.85;}
  .hero .amount{font-family:var(--serif);font-size:34px;font-weight:700;margin-top:2px;}
  .hero .sub{font-size:11.5px;opacity:.8;margin-top:4px;}

  .sheet-wrap{display:flex;gap:18px;overflow-x:auto;margin-top:18px;padding-bottom:6px;}
  .sheet{
    width:520px;flex:0 0 520px;background:#fff;border:1px solid var(--line);border-radius:4px;
    padding:26px 28px;font-size:12px;color:#1c1c1c;
  }
  .sheet h3{font-family:var(--serif);font-size:15px;margin:0 0 16px;}
  .sheet .addr-block{display:flex;justify-content:space-between;margin-bottom:14px;}
  .sheet .addr-block .to{font-size:13px;border-bottom:1px solid #333;padding-bottom:4px;display:inline-block;}
  .sheet .from{text-align:right;font-size:11px;line-height:1.6;}
  .sheet .from-seal-row{display:flex;align-items:center;justify-content:flex-end;gap:8px;font-size:11px;font-weight:700;margin-bottom:2px;}
  .sheet .seal-img{width:34px;height:34px;object-fit:contain;}
  .sheet .total-box{border:1px solid #999;display:flex;margin-bottom:14px;}
  .sheet .total-box .k{background:#EDEDED;padding:8px 12px;font-size:12px;flex:0 0 130px;}
  .sheet .total-box .v{padding:8px 12px;font-size:16px;font-weight:700;text-align:right;flex:1;}
  .sheet table{font-size:11px;}
  .sheet th{background:#F2F2F2;color:#333;border:1px solid #ccc;position:static;}
  .sheet td{border:1px solid #ccc;}
  .sheet .sec-title{background:#E4E4E4;font-weight:700;text-align:center;padding:5px;font-size:11.5px;border:1px solid #ccc;}

  .modal-backdrop{position:fixed;inset:0;background:rgba(20,26,20,.42);display:flex;align-items:center;justify-content:center;z-index:50;padding:20px;}
  .modal{background:#fff;border-radius:14px;padding:24px 26px;width:100%;max-width:520px;max-height:86vh;overflow:auto;}
  .modal h3{font-family:var(--serif);margin:0 0 14px;font-size:16px;}
  .field-row{margin-bottom:10px;}
  .field-row label{font-size:11.5px;color:var(--ink-soft);display:block;margin-bottom:4px;}
  .field-row input{width:100%;padding:8px 9px;border:1px solid var(--line);border-radius:8px;}
  .field-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;}
  fieldset{border:1px solid var(--line-soft);border-radius:10px;padding:10px 12px;margin:14px 0;}
  legend{font-size:11px;color:var(--ink-faint);padding:0 6px;font-weight:700;}

  .empty{color:var(--ink-faint);font-size:12.5px;padding:20px 0;text-align:center;}

  @media print{
    body{background:#fff;}
    .no-print{display:none !important;}
    .layout{display:block;max-width:none;}
    .content{padding:0;}
    .step{border:none;padding:0;margin:0;}
    .sheet-wrap{overflow:visible;display:block;}
    .sheet{width:190mm;padding:12mm;border:none;page-break-after:always;}
  }
  @media (max-width: 880px){
    .layout{flex-direction:column;}
    .sidebar{width:100%;flex:none;position:static;flex-direction:row;flex-wrap:wrap;}
    .sidebar-section{flex:1 1 200px;}
  }
</style>
</head>
<body>
<div id="app">
  <div class="topbar no-print">
    <div class="brand">
      <span class="mark">業務委託費 計算ツール</span>
      <span class="sub">売上明細 → 分類確認 → 支給明細書</span>
    </div>
    <div class="topbar-actions no-print">
      <button id="btnCompany">会社情報</button>
    </div>
  </div>

  <div class="layout">
    <aside class="sidebar no-print">
      <div class="sidebar-section">
        <h3>スタッフ</h3>
        <select id="staffSelect"></select>
        <button class="side-btn" id="btnAddStaff">＋ スタッフを追加</button>
        <button class="side-btn" id="btnEditStaff">基本情報を編集</button>
      </div>
      <div class="sidebar-section">
        <h3>対象月</h3>
        <input type="month" id="monthInput">
      </div>
      <div class="sidebar-section">
        <h3>保存データ</h3>
        <button class="side-btn primary" id="btnSaveRecord">この内容を保存</button>
        <button class="side-btn" id="btnLoadRecord">保存データを読み込む</button>
        <div class="hint" id="savedHint">この月の保存データはまだありません。</div>
      </div>
    </aside>

    <main class="content">

      <section class="step no-print" id="step1">
        <div class="step-head"><span class="step-no">01</span><h2>売上明細（CSV）を取り込む</h2></div>
        <div class="step-desc">サロンボードから出力したCSVをそのままアップロードしてください。選択中のスタッフ名で自動的に絞り込みます。</div>
        <div class="row-flex">
          <input type="file" id="csvFile" accept=".csv" class="no-print">
          <button class="btn ghost small no-print" id="btnEncodingToggle">文字化けする場合はUTF-8で再読込</button>
        </div>
        <div id="step1Stats"></div>
      </section>

      <section class="step no-print" id="step2">
        <div class="step-head"><span class="step-no">02</span><h2>分類の確認・修正</h2></div>
        <div class="step-desc">商品（メニュー区分）はスタッフごとに設定できます。単価・歩合率・キーワードを編集すると、CSVの自動分類にも反映されます。</div>

        <button class="compare-toggle no-print" id="btnToggleProducts">＋ 商品を編集する（単価・歩合率・キーワード）</button>
        <div class="panel-box no-print" id="productsBox" style="display:none;"></div>

        <div class="rows-scroll" id="rowsTableWrap"></div>

        <h3 style="font-family:var(--serif);font-size:14.5px;margin:20px 0 4px;">区分ごとの集計</h3>
        <div id="catTableWrap"></div>

        <h3 style="font-family:var(--serif);font-size:14.5px;margin:22px 0 4px;">控除</h3>
        <button class="compare-toggle no-print" id="btnToggleDeductions">＋ 控除項目を編集する</button>
        <div class="panel-box no-print" id="deductionsBox" style="display:none;"></div>
        <div id="deductWrap"></div>
      </section>

      <section class="step" id="step3">
        <div class="step-head no-print"><span class="step-no">03</span><h2>支給明細書</h2></div>
        <div id="heroWrap" class="no-print"></div>
        <div class="row-flex no-print" style="margin-top:16px;">
          <button class="btn" id="btnPrint">支給明細書をPDF保存 / 印刷</button>
        </div>
        <div class="sheet-wrap" id="sheetWrap"></div>
      </section>

    </main>
  </div>

</div>

<div id="modalRoot"></div>

<script>
/* ============================== 既定値 ============================== */
const SEAL_DEFAULT_DATA_URI = 'data:image/png;base64,';
const DEFAULT_PRICES = {C30:3500,C60:6000,C90:8500,C120:11000,S60:6500,S90:9000,S120:11500,KOGAO:0,EMS:2000,EXT10:1000};
const DEFAULT_RATE_STANDARD = 0.45;
const DEFAULT_RATE_HEAD = 0.50;
const DEFAULT_DEDUCTIONS = {insurance:1800, transferFee:330};
const DEFAULT_LINEN_RATE_PCT = 1; // 支給総額に対する % (ユーザー指定: リネン費 = 支給総額の1%)

function mkProduct(label, kind, price, rate, extra){
  return Object.assign({
    id: uid(), label, kind, price: price||0, rate: rate||0,
    keywords: [], csvCategoryMatch: '', durationMinutes: null,
    durationFallbackCategories: [],
    isSet: false, isCatchAll: false, autoSource: null
  }, extra||{});
}
const DEFAULT_DURATION_CATEGORIES = ['整体','ボディケア','足裏・リフレ','その他'];
function defaultProducts(prices, rateStd, rateHead, nominationUnit){
  prices = prices || DEFAULT_PRICES;
  rateStd = rateStd!=null ? rateStd : DEFAULT_RATE_STANDARD;
  rateHead = rateHead!=null ? rateHead : DEFAULT_RATE_HEAD;
  return [
    mkProduct('コース30分','count',prices.C30,rateStd,{durationMinutes:30,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('コース60分','count',prices.C60,rateStd,{durationMinutes:60,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('コース90分','count',prices.C90,rateStd,{durationMinutes:90,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('コース120分','count',prices.C120,rateStd,{durationMinutes:120,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('セット60分','count',prices.S60,rateStd,{durationMinutes:60,isSet:true,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('セット90分','count',prices.S90,rateStd,{durationMinutes:90,isSet:true,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('セット120分','count',prices.S120,rateStd,{durationMinutes:120,isSet:true,durationFallbackCategories:[...DEFAULT_DURATION_CATEGORIES]}),
    mkProduct('小顔','count',prices.KOGAO||0,rateStd,{keywords:['小顔']}),
    mkProduct('EMS','count',prices.EMS,rateStd,{keywords:['EMS']}),
    mkProduct('特別メニュー(合計)','aggregate',0,rateStd,{isCatchAll:true}),
    mkProduct('ヘッドメニュー(合計)','aggregate',0,rateHead,{csvCategoryMatch:'ヘッド'}),
    mkProduct('延長10分','count',prices.EXT10,rateStd,{keywords:['延長']}),
    mkProduct('指名料','manual',nominationUnit||0,rateStd,{autoSource:'nomination'}),
  ];
}

function mkDeduction(label, kind, value){
  return { id: uid(), label, kind, amount: kind==='fixed' ? (value||0) : 0, percent: kind==='percent' ? (value||0) : 0 };
}
function defaultDeductions(insurance, transferFee, linenPct){
  return [
    mkDeduction('保険料','fixed', insurance!=null?insurance:DEFAULT_DEDUCTIONS.insurance),
    mkDeduction('振込手数料','fixed', transferFee!=null?transferFee:DEFAULT_DEDUCTIONS.transferFee),
    mkDeduction('リネン費','percent', linenPct!=null?linenPct:DEFAULT_LINEN_RATE_PCT),
    mkDeduction('材料費','fixed', 0),
  ];
}

/* ============================== ストレージ ============================== */
const MEM_FALLBACK = {};
const LS_PREFIX = 'itaku-tool:';
function memKey(key,shared){ return (shared?'shared:':'priv:')+key; }
function hasClaudeStorage(){ return typeof window.storage!=='undefined' && window.storage && typeof window.storage.get==='function'; }
async function sGet(key, shared){
  if(hasClaudeStorage()){
    try{ const r = await window.storage.get(key, !!shared); return r ? JSON.parse(r.value) : null; }
    catch(e){ /* fall through to localStorage */ }
  }
  try{
    const v = window.localStorage.getItem(LS_PREFIX+memKey(key,shared));
    return v!=null ? JSON.parse(v) : null;
  }catch(e){ return MEM_FALLBACK[memKey(key,shared)] ?? null; }
}
async function sSet(key,val, shared){
  if(hasClaudeStorage()){
    try{ await window.storage.set(key, JSON.stringify(val), !!shared); return; }
    catch(e){ /* fall through to localStorage */ }
  }
  try{ window.localStorage.setItem(LS_PREFIX+memKey(key,shared), JSON.stringify(val)); }
  catch(e){ MEM_FALLBACK[memKey(key,shared)]=val; }
}

/* ============================== ユーティリティ ============================== */
function uid(){ return 'id'+Math.random().toString(36).slice(2,10); }
function yen(n){ n = Math.round(n||0); return '¥' + n.toLocaleString('ja-JP'); }
function normName(s){ return (s||'').replace(/[\s\u3000]+/g,''); }
function escapeHtml(s){
  return (s==null?'':String(s)).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function toHalfWidthDigits(s){
  return (s||'').replace(/[\uFF10-\uFF19]/g, ch => String.fromCharCode(ch.charCodeAt(0) - 0xFEE0));
}
function extractDuration(name){
  const m = toHalfWidthDigits(name||'').match(/(\d{2,3})\s*分/);
  return m ? parseInt(m[1],10) : null;
}
function parseCSVText(text){
  const rows=[]; let row=[], field='', inQ=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(inQ){
      if(c==='"'){ if(text[i+1]==='"'){field+='"';i++;} else inQ=false; }
      else field+=c;
    }else{
      if(c==='"') inQ=true;
      else if(c===','){ row.push(field); field=''; }
      else if(c==='\r'){ /* skip */ }
      else if(c==='\n'){ row.push(field); rows.push(row); row=[]; field=''; }
      else field+=c;
    }
  }
  if(field.length>0 || row.length>0){ row.push(field); rows.push(row); }
  return rows.filter(r => !(r.length===1 && r[0]===''));
}

/* 商品リストに基づく分類: キーワード一致 → CSVカテゴリ一致 → 分数の近さ → 受け皿 */
function classifyRow(menu, csvCat, products){
  const candidates = products.filter(p=>p.kind!=='manual');
  for(const p of candidates){
    if(p.isCatchAll) continue;
    for(const kw of (p.keywords||[])){ if(kw && menu.includes(kw)) return p.id; }
  }
  for(const p of candidates){
    if(p.isCatchAll) continue;
    if(p.csvCategoryMatch && csvCat===p.csvCategoryMatch) return p.id;
  }
  const wantSet = menu.includes('セット');
  const durPool = candidates.filter(p=>p.kind==='count' && p.durationMinutes!=null && !p.isCatchAll && !!p.isSet===wantSet &&
    (p.isSet || !p.durationFallbackCategories || p.durationFallbackCategories.length===0 || p.durationFallbackCategories.includes(csvCat)));
  if(durPool.length){
    const d = extractDuration(menu);
    if(d!=null){
      let best=null, bd=Infinity;
      for(const p of durPool){ const diff=Math.abs(p.durationMinutes-d); if(diff<bd){bd=diff;best=p;} }
      if(best) return best.id;
    }
  }
  const catchAll = candidates.find(p=>p.isCatchAll);
  return catchAll ? catchAll.id : (candidates[0] ? candidates[0].id : null);
}

